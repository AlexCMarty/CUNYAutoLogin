{
  "name": "cunyautologin",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings 0 src e2e",
    "build": "npm run lint && tsc --noEmit && vite build && vite build -c vite.content.config.ts",
    "build:dev": "npm run lint && tsc --noEmit && vite build --mode development && vite build -c vite.content.config.ts --mode development",
    "build:e2e": "cross-env E2E_MANIFEST=1 npm run build:dev",
    "watch": "vite build --watch --mode development",
    "build:content": "vite build -c vite.content.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "capture-sidebar": "node scripts/capture-sidebar.mjs",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^22.10.2",
    "@types/totp-generator": "^0.0.8",
    "@types/webextension-polyfill": "^0.12.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.4.2",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "neverthrow": "^8.2.0",
    "totp-generator": "^2.0.1",
    "webextension-polyfill": "^0.12.0"
  }
}
