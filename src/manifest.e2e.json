{
  "manifest_version": 3,
  "name": "CUNYAutoLogin",
  "version": "0.4.0",
  "description": "CUNYAutoLogin — encrypted credential vault and ssologin.cuny.edu auto-fill.",
  "permissions": ["storage", "activeTab", "sidePanel", "cookies"],
  "host_permissions": [
    "https://ssologin.cuny.edu/*",
    "https://brightspace.cuny.edu/*",
    "https://home.cunyfirst.cuny.edu/*",
    "https://*.cunyfirst.cuny.edu/*",
    "http://127.0.0.1:4173/*"
  ],
  "action": {
    "default_title": "CUNYAutoLogin"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "sidebar_action": {
    "default_title": "CUNYAutoLogin",
    "default_panel": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ssologin.cuny.edu/*",
        "http://127.0.0.1:4173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cunyautologin@local",
      "strict_min_version": "115.0"
    }
  },
  "minimum_chrome_version": "114"
}
